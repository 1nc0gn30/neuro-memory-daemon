#!/usr/bin/env python3
"""Neuro-Memory Daemon v2.9.0 — Live Read-Only Braille Telemetry TUI
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
Queries strictly read-only loopback endpoints on http://127.0.0.1:8094
(/health and /api/stats) with graceful offline reporting.
"""
from __future__ import annotations

import argparse
import json
import sys
import time
import urllib.error
import urllib.request
from typing import Any, Dict, List, Tuple

VERSION = "2.9.0"
BRAILLE_BASE = 0x2800


def fetch_json_readonly(url: str, timeout: float = 1.5) -> Tuple[bool, Dict[str, Any]]:
    """Perform a strictly read-only GET request to a loopback URL."""
    req = urllib.request.Request(
        url,
        headers={"Accept": "application/json", "User-Agent": f"neuro-memory-daemon-tui/{VERSION}"},
        method="GET",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                return True, data if isinstance(data, dict) else {}
    except Exception:
        pass
    return False, {}


def braille_bars(values: List[float], width: int = 24) -> str:
    """Encode real normalized numeric values [0..1] into U+2800 2x4 Braille glyphs."""
    if not values:
        return "⠀" * (width // 2)
    padded = list(values[:width])
    while len(padded) < width:
        padded.append(0.0)
    out = []
    levels_l = (0x40, 0x44, 0x46, 0x47)
    levels_r = (0x80, 0xA0, 0xB0, 0xB8)
    for i in range(0, len(padded) - 1, 2):
        v1 = max(0, min(3, int(round(padded[i] * 3))))
        v2 = max(0, min(3, int(round(padded[i + 1] * 3))))
        glyph = BRAILLE_BASE | (levels_l[v1] if padded[i] > 0 else 0) | (levels_r[v2] if padded[i + 1] > 0 else 0)
        out.append(chr(glyph))
    return "".join(out)


def collect_live_snapshot(base_url: str) -> Dict[str, Any]:
    t0 = time.perf_counter()
    ok_health, health = fetch_json_readonly(f"{base_url}/health")
    ok_stats, stats = fetch_json_readonly(f"{base_url}/api/stats")
    latency_ms = round((time.perf_counter() - t0) * 1000.0, 2)

    categories = stats.get("categories") if isinstance(stats.get("categories"), dict) else {}
    top_cats = sorted(categories.items(), key=lambda kv: kv[1], reverse=True)[:12]
    max_cat = max((v for _, v in top_cats), default=1) or 1
    cat_profile = [float(v) / float(max_cat) for _, v in top_cats]

    return {
        "tool": "neuro-memory-daemon-tui",
        "service": "neuro-memory-daemon",
        "version": VERSION,
        "daemon_version": health.get("version") or ("offline" if not ok_health else "unknown"),
        "base_url": base_url,
        "online": bool(ok_health and ok_stats),
        "probe_latency_ms": latency_ms,
        "total_memories": int(stats.get("total_memories", 0) or 0),
        "total_synapses": int(stats.get("total_synapses", 0) or 0),
        "synaptic_density": float(stats.get("synaptic_density", 0.0) or 0.0),
        "average_importance": float(stats.get("average_importance", 0.0) or 0.0),
        "category_count": len(categories),
        "top_categories": [{"name": k, "count": int(v)} for k, v in top_cats[:6]],
        "braille_distribution": braille_bars(cat_profile, width=24),
        "author": "Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
        "repository": "https://github.com/1nc0gn30/neuro-memory-daemon",
    }


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="neuro-memory-daemon-tui",
        description="Live read-only Unicode Braille telemetry TUI for Neuro-Memory Daemon (:8094).",
    )
    ap.add_argument("--url", default="http://127.0.0.1:8094", help="Loopback daemon base URL")
    ap.add_argument("--json", action="store_true", help="Output live JSON telemetry and exit")
    ap.add_argument("--status", action="store_true", help="Print compact one-line status and exit")
    ap.add_argument("-v", "--version", action="version", version=f"neuro-memory-daemon-tui v{VERSION}")
    args = ap.parse_args()

    snap = collect_live_snapshot(args.url.rstrip("/"))

    if args.json:
        print(json.dumps(snap, indent=2))
        return 0

    if args.status:
        state = "ONLINE" if snap["online"] else "OFFLINE"
        print(
            f"neuro-memory-daemon-tui v{VERSION} | {state} {snap['base_url']} | "
            f"engrams={snap['total_memories']:,} synapses={snap['total_synapses']:,} "
            f"density={snap['synaptic_density']:.2f} latency={snap['probe_latency_ms']}ms"
        )
        return 0

    state_badge = "\033[1;32mONLINE\033[0m" if snap["online"] else "\033[1;31mOFFLINE\033[0m"
    print("\033[1;33m╭──────────────────────────────────────────────────────────────────────────╮\033[0m")
    print(
        f"\033[1;33m│\033[0m \033[1;37mNeuro-Memory Daemon v{VERSION}\033[0m"
        f"  [{state_badge}]  \033[36m{snap['base_url']:<24}\033[0m    \033[1;33m│\033[0m"
    )
    print("\033[1;33m├──────────────────────────────────────────────────────────────────────────┤\033[0m")
    print(
        f"\033[1;33m│\033[0m Engrams: \033[1;37m{snap['total_memories']:>8,}\033[0m"
        f"  │ Synapses: \033[1;37m{snap['total_synapses']:>10,}\033[0m"
        f"  │ Density: \033[1;33m{snap['synaptic_density']:>6.2f}\033[0m        \033[1;33m│\033[0m"
    )
    print(
        f"\033[1;33m│\033[0m Categories: \033[1;37m{snap['category_count']:>5}\033[0m"
        f"  │ Avg Importance: \033[1;37m{snap['average_importance']:>5.3f}\033[0m"
        f"  │ Probe: \033[1;36m{snap['probe_latency_ms']:>6.2f} ms\033[0m     \033[1;33m│\033[0m"
    )
    print(
        f"\033[1;33m│\033[0m Category Distribution (U+2800): \033[1;33m{snap['braille_distribution']}\033[0m                           \033[1;33m│\033[0m"
    )
    for cat in snap["top_categories"][:4]:
        print(
            f"\033[1;33m│\033[0m  • {cat['name'][:26]:<26} \033[36m{cat['count']:>8,}\033[0m engrams"
            f"                         \033[1;33m│\033[0m"
        )
    print("\033[1;33m├──────────────────────────────────────────────────────────────────────────┤\033[0m")
    print("\033[1;33m│\033[0m Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform            \033[1;33m│\033[0m")
    print("\033[1;33m╰──────────────────────────────────────────────────────────────────────────╯\033[0m")
    return 0


if __name__ == "__main__":
    sys.exit(main())
